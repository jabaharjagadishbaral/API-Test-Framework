{
  "info": {
    "name": "Users API - REST Test Framework",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:5055" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Login (admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"admin123\"}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/users?limit=20&offset=0"
      }
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"New User\", \"email\": \"new.user@example.com\", \"age\": 30}"
        },
        "url": "{{base_url}}/users"
      }
    },
    {
      "name": "Get user by id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/users/1"
      }
    },
    {
      "name": "Delete user (admin only)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/users/1"
      }
    }
  ]
}
